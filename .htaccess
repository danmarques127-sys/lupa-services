# ============================================
# .htaccess — lupaservices.com (Apache/GoDaddy)
# - Corrige redirect loop (www/non-www + https)
# - UTF-8
# - Security headers
# ============================================

RewriteEngine On

# ===============================
# FORCE HTTPS + FORCE NON-WWW (single-step, avoids loops)
# ===============================
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.lupaservices\.com$ [NC]
RewriteRule ^ https://lupaservices.com%{REQUEST_URI} [L,R=301,NE]

# ===============================
# FORCE UTF-8 (IMPORTANT)
# ===============================
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .htm .css .js .json .xml .txt .svg

# ===============================
# SECURITY HEADERS
# ===============================
<IfModule mod_headers.c>
  # HSTS (seguro). Quando tiver 100% certo do SSL em tudo/subdomínios, aí sim dá pra incluirSubDomains/preload.
  Header always set Strict-Transport-Security "max-age=31536000"

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=()"

  # CSP (permite site + libs externas + inline scripts/styles)
  # - connect-src: permite fetch/XHR (Formspree + Geoapify + OSM + Google Ads + Analytics)
  # - form-action: permite submit normal (também inclui Formspree)
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://formspree.io; img-src 'self' https: data:; script-src 'self' https: 'unsafe-inline'; style-src 'self' https: 'unsafe-inline'; connect-src 'self' https://formspree.io https://api.geoapify.com https://maps.geoapify.com https://nominatim.openstreetmap.org https://www.google.com https://www.googletagmanager.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://ad.doubleclick.net https://www.google-analytics.com; font-src 'self' https: data:; frame-src https://www.youtube-nocookie.com; upgrade-insecure-requests"
</IfModule>